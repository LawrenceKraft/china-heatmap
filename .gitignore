# Dependencies
node_modules/

# Build output (regenerated by `npm run build` in CI)
dist/

# EdgeOne CLI local state (never commit)
.edgeone/

# Assemble output (regenerated by `npm run build:site`, consumed by
# GitHub Pages workflow and EdgeOne Pages)
site/

# Source maps (optional, keep them out to keep repo small)
*.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.codebuddy/
*.swp
*.swo

# Environment
.env
.env.local
.env.*.local

# Temporary / cache
.cache/
.tmp/
.temp/

# Test screenshots generated during development
table-scroll-test.png
.playwright-cli/
