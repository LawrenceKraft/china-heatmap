{
  "name": "china-heatmap",
  "version": "2.0.0",
  "description": "China data heatmap visualizer - TypeScript modular static project for EdgeOne Pages",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:site": "npm run build && node scripts/assemble-site.mjs",
    "dev": "tsc --watch",
    "serve": "node scripts/serve-local.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('site',{recursive:true,force:true})\"",
    "gen-template": "node scripts/gen-template.mjs",
    "gen-outline": "node scripts/gen-map-outline.mjs"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT"
}
